{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://atomicstryker.github.io/",
    "issues": "https://github.com/AtomicStryker/atomicstrykers-minecraft-mods/issues",
    "sources": "https://github.com/AtomicStryker/atomicstrykers-minecraft-mods"
  },
  "license": "AtomicStrykers License ${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "atomicstryker.infernalmobs.common.InfernalMobsCore"
    ],
    "client": [
      "atomicstryker.infernalmobs.client.InfernalMobsClient"
    ]
  },
  "mixins": [
    "infernalmobs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
